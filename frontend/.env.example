# Frontend Environment Variables
# Copy this file to .env and fill in your values

# Supabase — get these from your Supabase project dashboard
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# API Base URL — the FastAPI backend URL
# In development, the Vite proxy handles this, so you can leave it empty
# In production, set this to your deployed backend URL
VITE_API_BASE_URL=
